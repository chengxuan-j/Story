# MySQL 连接配置（复制为系统环境变量后再启动后端）
# 本项目的约定：连接信息从系统环境变量读取，不写进代码或 .env 文件。
#
# Windows PowerShell（用户级，重开终端生效）：
#   [Environment]::SetEnvironmentVariable('MYSQL_HOST','127.0.0.1','User')
#   [Environment]::SetEnvironmentVariable('MYSQL_PORT','3306','User')
#   [Environment]::SetEnvironmentVariable('MYSQL_USER','root','User')
#   [Environment]::SetEnvironmentVariable('MYSQL_PASSWORD','你的密码','User')
#   [Environment]::SetEnvironmentVariable('MYSQL_DATABASE','story','User')

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=story
MYSQL_CHARSET=utf8mb4

# DashScope API Key（也已设为系统环境变量 DASHSCOPE_API_KEY）
# DASHSCOPE_API_KEY=sk-...
